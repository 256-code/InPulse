# Normalize repository text to LF across Windows, macOS and Linux.
* text=auto eol=lf

# Native Windows command scripts use CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary assets must not be normalized or shown as text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
*.tar binary

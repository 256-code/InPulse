{
  "openapi": "3.1.0",
  "info": {
    "title": "InPulse API",
    "version": "1.0.0",
    "description": "由 packages/api-contract 的 Schema Registry 与 Route Registry 生成，禁止手工修改。"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/csrf": {
      "get": {
        "operationId": "issueCsrfToken",
        "summary": "匿名或已登录用户签发一次性同步 CSRF Token；匿名时创建预认证 Session。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfIssueResponse"
                }
              }
            }
          }
        },
        "x-inpulse-policy": {
          "authPolicy": "none",
          "csrfPolicy": "none",
          "idempotencyPolicy": "securityFlow",
          "idempotencyExceptionAdr": "ADR-023",
          "idempotencyContractVersion": "none",
          "idempotencyFingerprintVersion": "none",
          "behaviorHeaders": "none",
          "idempotencyReplayPolicy": "none",
          "replayAuthorizationPolicy": "none",
          "securityFlowPolicy": {
            "singleConsumptionOrNaturalIdempotency": "每次签发新 Token 并轮换匿名预认证 Session，数据库只保存 Hash；已登录 Session 复用同一 Session 并最多保留 4 个有效 Hash",
            "clientRecoveryPath": "再次调用签发端点"
          },
          "versionPolicy": "none",
          "concurrencyPolicy": "none",
          "auditAction": "none"
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "只接受匿名预认证 Session 与 X-CSRF-Token；成功后消费预认证 Session、轮换 Cookie 并签发新认证 Session 与 CSRF Token。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        },
        "x-inpulse-policy": {
          "authPolicy": "none",
          "csrfPolicy": "required",
          "idempotencyPolicy": "securityFlow",
          "idempotencyExceptionAdr": "ADR-023",
          "idempotencyContractVersion": "none",
          "idempotencyFingerprintVersion": "none",
          "behaviorHeaders": "none",
          "idempotencyReplayPolicy": "none",
          "replayAuthorizationPolicy": "none",
          "securityFlowPolicy": {
            "singleConsumptionOrNaturalIdempotency": "同一匿名预认证 Session 与其 CSRF Hash 只能成功登录一次；成功时在同一事务条件消费预认证 Session，并创建新的认证 Session 与 CSRF Hash",
            "clientRecoveryPath": "若已有认证/受限 Session 先登出或清 Cookie，再重新调用 CSRF 签发端点并登录"
          },
          "versionPolicy": "none",
          "concurrencyPolicy": "none",
          "auditAction": "none"
        },
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "有效 Session 验证同源与当前 CSRF Token 后在事务内撤销；无效或已撤销 Session 仅清 Cookie，统一返回 204。",
        "responses": {
          "204": {
            "description": "成功且无响应体"
          }
        },
        "x-inpulse-policy": {
          "authPolicy": "none",
          "csrfPolicy": "required",
          "idempotencyPolicy": "securityFlow",
          "idempotencyExceptionAdr": "ADR-023",
          "idempotencyContractVersion": "none",
          "idempotencyFingerprintVersion": "none",
          "behaviorHeaders": "none",
          "idempotencyReplayPolicy": "none",
          "replayAuthorizationPolicy": "none",
          "securityFlowPolicy": {
            "singleConsumptionOrNaturalIdempotency": "有效 Session 只在同一事务验证 CSRF 后条件撤销；无效或已撤销 Session 的同源重试仅清 Cookie，不执行状态写",
            "clientRecoveryPath": "直接重试同一登出请求；有效 Session 需先调用 CSRF 签发端点取得当前 Token"
          },
          "versionPolicy": "none",
          "concurrencyPolicy": "none",
          "auditAction": "none"
        },
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43
            }
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "存活探针，不访问数据库，不需要认证。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "x-inpulse-policy": {
          "authPolicy": "none",
          "csrfPolicy": "none",
          "idempotencyPolicy": "none",
          "idempotencyExceptionAdr": "none",
          "idempotencyContractVersion": "none",
          "idempotencyFingerprintVersion": "none",
          "behaviorHeaders": "none",
          "idempotencyReplayPolicy": "none",
          "replayAuthorizationPolicy": "none",
          "securityFlowPolicy": "none",
          "versionPolicy": "none",
          "concurrencyPolicy": "none",
          "auditAction": "none"
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "getSearch",
        "summary": "按服务端 AuthorizedProjectScope 搜索当前用户可访问项目中的投影实体；普通输入使用 PGroonga 转义查询，禁止客户端传入授权范围；cursor 为服务端签名、校验并带过期时间的不透明字符串；includeVoid=true 仅供系统管理员显式开启 VOID 可见，普通调用不影响范围。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPage"
                }
              }
            }
          },
          "401": {
            "description": "未登录或 Session 失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "字段校验错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "未预期错误，不向客户端泄露堆栈",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-inpulse-policy": {
          "authPolicy": "session",
          "csrfPolicy": "none",
          "idempotencyPolicy": "none",
          "idempotencyExceptionAdr": "none",
          "idempotencyContractVersion": "none",
          "idempotencyFingerprintVersion": "none",
          "behaviorHeaders": "none",
          "idempotencyReplayPolicy": "none",
          "replayAuthorizationPolicy": "none",
          "securityFlowPolicy": "none",
          "versionPolicy": "none",
          "concurrencyPolicy": "none",
          "auditAction": "none"
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "includeVoid",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CsrfIssueResponse": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "required": [
          "csrfToken"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "requestId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "requestId"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "LoginHeaders": {
        "type": "object",
        "properties": {
          "x-csrf-token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "required": [
          "x-csrf-token"
        ],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "loginName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "loginName",
          "password"
        ],
        "additionalProperties": false
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43
          },
          "authState": {
            "type": "string",
            "enum": [
              "AUTHENTICATED",
              "MFA_ENROLLMENT",
              "MFA_CHALLENGE",
              "RECOVERY_CHALLENGE"
            ]
          }
        },
        "required": [
          "csrfToken",
          "authState"
        ],
        "additionalProperties": false
      },
      "LogoutHeaders": {
        "type": "object",
        "properties": {
          "x-csrf-token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "additionalProperties": false
      },
      "SearchItem": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "entityType": {
            "type": "string",
            "enum": [
              "PROJECT",
              "MODULE",
              "FEATURE",
              "TASK",
              "CHANGE_RECORD",
              "EXTERNAL_LINK",
              "TASK_GROUP"
            ]
          },
          "entityId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "summary": {
            "type": "string",
            "maxLength": 5000
          }
        },
        "required": [
          "projectId",
          "entityType",
          "entityId",
          "title",
          "summary"
        ],
        "additionalProperties": false
      },
      "SearchPage": {
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchItem"
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "hasMore"
        ],
        "additionalProperties": false
      },
      "SearchQueryRequest": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "includeVoid": {
            "type": "boolean"
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      },
      "UserAuthState": {
        "type": "string",
        "enum": [
          "AUTHENTICATED",
          "MFA_ENROLLMENT",
          "MFA_CHALLENGE",
          "RECOVERY_CHALLENGE"
        ]
      }
    }
  }
}

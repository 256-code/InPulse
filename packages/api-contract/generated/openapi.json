                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "x-inpulse-policy": {
          "authPolicy": "none",
          "csrfPolicy": "none",
          "idempotencyPolicy": "none",
          "idempotencyExceptionAdr": "none",
          "idempotencyContractVersion": "none",
          "idempotencyFingerprintVersion": "none",
          "behaviorHeaders": "none",
          "idempotencyReplayPolicy": "none",
          "replayAuthorizationPolicy": "none",
          "securityFlowPolicy": "none",
          "versionPolicy": "none",
          "concurrencyPolicy": "none",
          "auditAction": "none"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "requestId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "requestId"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      }
    }
  }
}

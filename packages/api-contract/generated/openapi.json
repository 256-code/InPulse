{
  "openapi": "3.1.0",
  "info": {
    "title": "InPulse API",
    "version": "1.0.0",
    "description": "由 packages/api-contract 的 Schema Registry 与 Route Registry 生成，禁止手工修改。"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/csrf": {
      "get": {
        "operationId": "issueCsrfToken",
        "summary": "匿名或已登录用户签发一次性同步 CSRF Token；匿名时创建预认证 Session。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfIssueResponse"
                }
              }
            }
          }
        },
        "x-inpulse-policy": {
          "authPolicy": "none",
          "csrfPolicy": "none",
          "idempotencyPolicy": "securityFlow",
          "idempotencyExceptionAdr": "ADR-023",
          "idempotencyContractVersion": "none",
          "idempotencyFingerprintVersion": "none",
          "behaviorHeaders": "none",
          "idempotencyReplayPolicy": "none",
          "replayAuthorizationPolicy": "none",
          "securityFlowPolicy": {
            "singleConsumptionOrNaturalIdempotency": "每次签发新 Token 并轮换匿名预认证 Session，数据库只保存 Hash；已登录 Session 复用同一 Session 并最多保留 4 个有效 Hash",
            "clientRecoveryPath": "再次调用签发端点"
          },
          "versionPolicy": "none",
          "concurrencyPolicy": "none",
          "auditAction": "none"
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "只接受匿名预认证 Session 与 X-CSRF-Token；成功后消费预认证 Session、轮换 Cookie 并签发新认证 Session 与 CSRF Token。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "429": {
            "description": "限流",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-inpulse-policy": {
          "authPolicy": "none",
          "csrfPolicy": "required",
          "idempotencyPolicy": "securityFlow",
          "idempotencyExceptionAdr": "ADR-023",
          "idempotencyContractVersion": "none",
          "idempotencyFingerprintVersion": "none",
          "behaviorHeaders": "none",
          "idempotencyReplayPolicy": "none",
          "replayAuthorizationPolicy": "none",
          "securityFlowPolicy": {
            "singleConsumptionOrNaturalIdempotency": "同一匿名预认证 Session 与其 CSRF Hash 只能成功登录一次；成功时在同一事务条件消费预认证 Session，并创建新的认证 Session 与 CSRF Hash",
            "clientRecoveryPath": "若已有认证/受限 Session 先登出或清 Cookie，再重新调用 CSRF 签发端点并登录"
          },
          "versionPolicy": "none",
          "concurrencyPolicy": "none",
          "auditAction": "none"
        },
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "有效 Session 验证同源与当前 CSRF Token 后在事务内撤销；无效或已撤销 Session 仅清 Cookie，统一返回 204。",
        "responses": {
          "204": {
            "description": "成功且无响应体"
          }
        },
        "x-inpulse-policy": {
          "authPolicy": "none",
          "csrfPolicy": "required",
          "idempotencyPolicy": "securityFlow",
          "idempotencyExceptionAdr": "ADR-023",
          "idempotencyContractVersion": "none",
          "idempotencyFingerprintVersion": "none",
          "behaviorHeaders": "none",
          "idempotencyReplayPolicy": "none",
          "replayAuthorizationPolicy": "none",
          "securityFlowPolicy": {
            "singleConsumptionOrNaturalIdempotency": "有效 Session 只在同一事务验证 CSRF 后条件撤销；无效或已撤销 Session 的同源重试仅清 Cookie，不执行状态写",
            "clientRecoveryPath": "直接重试同一登出请求；有效 Session 需先调用 CSRF 签发端点取得当前 Token"
          },
          "versionPolicy": "none",
          "concurrencyPolicy": "none",
          "auditAction": "none"
        },
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43
            }
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "存活探针，不访问数据库，不需要认证。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "x-inpulse-policy": {
          "authPolicy": "none",
          "csrfPolicy": "none",
          "idempotencyPolicy": "none",
          "idempotencyExceptionAdr": "none",
          "idempotencyContractVersion": "none",
          "idempotencyFingerprintVersion": "none",
          "behaviorHeaders": "none",
          "idempotencyReplayPolicy": "none",
          "replayAuthorizationPolicy": "none",
          "securityFlowPolicy": "none",
          "versionPolicy": "none",
          "concurrencyPolicy": "none",
          "auditAction": "none"
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "返回当前登录用户资料；身份由服务端从 Session Cookie 解析。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          }
        },
        "x-inpulse-policy": {
          "authPolicy": "session",
          "csrfPolicy": "none",
          "idempotencyPolicy": "none",
          "idempotencyExceptionAdr": "none",
          "idempotencyContractVersion": "none",
          "idempotencyFingerprintVersion": "none",
          "behaviorHeaders": "none",
          "idempotencyReplayPolicy": "none",
          "replayAuthorizationPolicy": "none",
          "securityFlowPolicy": "none",
          "versionPolicy": "none",
          "concurrencyPolicy": "none",
          "auditAction": "none"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CsrfIssueResponse": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "required": [
          "csrfToken"
        ],
        "additionalProperties": false
      },
      "CurrentUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "loginName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 3,
                "maxLength": 320
              },
              {
                "type": "null"
              }
            ]
          },
          "avatarUrl": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          },
          "isAdmin": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          }
        },
        "required": [
          "id",
          "loginName",
          "name",
          "email",
          "avatarUrl",
          "isAdmin",
          "status"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "requestId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "requestId"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "LoginHeaders": {
        "type": "object",
        "properties": {
          "x-csrf-token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "required": [
          "x-csrf-token"
        ],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "loginName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "loginName",
          "password"
        ],
        "additionalProperties": false
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43
          },
          "authState": {
            "type": "string",
            "enum": [
              "AUTHENTICATED",
              "MFA_ENROLLMENT",
              "MFA_CHALLENGE",
              "RECOVERY_CHALLENGE"
            ]
          }
        },
        "required": [
          "csrfToken",
          "authState"
        ],
        "additionalProperties": false
      },
      "LogoutHeaders": {
        "type": "object",
        "properties": {
          "x-csrf-token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "additionalProperties": false
      },
      "UserAuthState": {
        "type": "string",
        "enum": [
          "AUTHENTICATED",
          "MFA_ENROLLMENT",
          "MFA_CHALLENGE",
          "RECOVERY_CHALLENGE"
        ]
      }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "InPulse API",
    "version": "1.0.0",
    "description": "由 packages/api-contract 的 Schema Registry 与 Route Registry 生成，禁止手工修改。"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/csrf": {
      "get": {
        "operationId": "issueCsrfToken",
        "summary": "匿名或已登录用户签发一次性同步 CSRF Token；匿名时创建预认证 Session。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfIssueResponse"
                }
              }
            }
          }
        },
        "x-inpulse-policy": {
          "authPolicy": "none",
          "csrfPolicy": "none",
          "idempotencyPolicy": "securityFlow",
          "idempotencyExceptionAdr": "ADR-023",
          "idempotencyContractVersion": "none",
          "idempotencyFingerprintVersion": "none",
          "behaviorHeaders": "none",
          "idempotencyReplayPolicy": "none",
          "replayAuthorizationPolicy": "none",
          "securityFlowPolicy": {
            "singleConsumptionOrNaturalIdempotency": "每次签发新 Token 并轮换匿名预认证 Session，数据库只保存 Hash；已登录 Session 复用同一 Session 并最多保留 4 个有效 Hash",
            "clientRecoveryPath": "再次调用签发端点"
          },
          "versionPolicy": "none",
          "concurrencyPolicy": "none",
          "auditAction": "none"
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "存活探针，不访问数据库，不需要认证。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "x-inpulse-policy": {
          "authPolicy": "none",
          "csrfPolicy": "none",
          "idempotencyPolicy": "none",
          "idempotencyExceptionAdr": "none",
          "idempotencyContractVersion": "none",
          "idempotencyFingerprintVersion": "none",
          "behaviorHeaders": "none",
          "idempotencyReplayPolicy": "none",
          "replayAuthorizationPolicy": "none",
          "securityFlowPolicy": "none",
          "versionPolicy": "none",
          "concurrencyPolicy": "none",
          "auditAction": "none"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CsrfIssueResponse": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "required": [
          "csrfToken"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "requestId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "requestId"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      }
    }
  }
}

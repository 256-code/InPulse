[Unit]
# InPulse 审计链头检查点（宿主每小时调度；技术设计 v1.2.2 §11.5 第 7 步、F-08 步骤 6）。
# 单元文件由 deploy/backup/audit-archivectl.sh enable 安装：__INPULSE_AUDIT_ARCHIVECTL__
# 会被替换为安装后的控制器绝对路径。上线前不得启用本单元。
Description=InPulse 审计链头检查点（每小时）
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/inpulse/audit-archive.env
ExecStart=__INPULSE_AUDIT_ARCHIVECTL__ run-checkpoint
# 超时或未开始都会走 OnFailure 告警（复用备份告警单元）。
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
OnFailure=inpulse-backup-alert@%N.service

[Install]
WantedBy=multi-user.target

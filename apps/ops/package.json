{
  "name": "@inpulse/ops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "start:backup": "node dist/backup-cli.js",
    "audit-archive": "tsx src/cli.ts",
    "backup": "tsx src/backup-cli.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@inpulse/canonical-json": "workspace:*",
    "@inpulse/database": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

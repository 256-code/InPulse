{
  "name": "@inpulse/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./schema/index.ts",
    "./client": "./src/client.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "migrations:check": "tsx src/check-migrations.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
